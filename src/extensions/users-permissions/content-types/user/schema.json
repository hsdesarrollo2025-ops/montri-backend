{
  "collectionName": "users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false,
    "timestamps": true
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "required": true,
      "unique": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "required": true,
      "unique": true
    },
    "password": {
      "type": "password",
      "minLength": 8,
      "required": true
    },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "planType": {
      "type": "enumeration",
      "enum": ["free", "pro", "premium"],
      "default": "free"
    },
    "acceptedTerms": { "type": "boolean", "default": false },
    "confirmed": { "type": "boolean", "default": false },
    "blocked": { "type": "boolean", "default": false },
    "roles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.role"
    },
    "fiscalProfile": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::fiscal-profile.fiscal-profile",
      "mappedBy": "user"
    }
  }
}
